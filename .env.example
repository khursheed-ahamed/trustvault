DJANGO_ENV=development
DEBUG=True
SECRET_KEY=<generate-a-random-local-secret>
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
TIME_ZONE=Asia/Kolkata

# Leave all AWS_* values blank for local filesystem storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_SIGNATURE_VERSION=s3v4
